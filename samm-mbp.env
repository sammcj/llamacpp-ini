# Per-host sync overrides, sourced by run-llama-server.sh on this machine.
#
# Qwen3.8-Flash-Next draft-mtp (the grafted-head model in samm-mbp.ini) needs
# llama.cpp PR #27836, built in the ~/git/llama.cpp-pr27836 worktree. Remove
# this override once the PR merges upstream and the normal install catches up.
export LLAMA_SERVER_BIN=/Users/samm/git/llama.cpp-pr27836/build/bin/llama-server

# Disables the QSA pooled-key cache from carried PR #28699. Its rows are one per
# position block per KV stream with a per-sequence watermark, so the moment two
# slots are live on the unified cache it trips GGML_ASSERT(n_dirty <= n_dirty_max)
# in llama-memory-hybrid-idx.cpp and the server aborts (bench-slots.sh, 2026-09-22).
# Costs the PR's decode gain at depth: tg32 40.3 -> 34.8 at d32768, 37.6 -> 28.1 at
# d65536, null at 4k. Remove once #28699 handles several sequences per stream;
# update-mtp-build.sh pauses with a reminder when that PR merges or its head moves.
export LLAMA_QSA_NO_POOLED_CACHE=1
