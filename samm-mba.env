# Per-host sync overrides, sourced by run-llama-server.sh on this machine.
# Only the sync-models size-tier thresholds live here; runtime/server defaults
# are in samm-mba.ini.
#
# On 16 GB the sub-40 GB "small-kv" tier is backwards: it would upgrade every
# runnable model's KV cache from q8_0 to f16/bf16 (~2x KV RAM). Disable it so
# small models keep the memory-cheap q8_0 base from samm-mba.ini. 0 means no
# model matches (bytes < 0 is never true). The ckpt tier never fires here
# (no models that large), so it is left at its default.
export SIZE_SMALL_KV_GB=0

# Router-resident model cap, passed as --models-max by run-llama-server.sh.
export LLAMA_MODELS_MAX=2
